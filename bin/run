#!/usr/bin/env bash
# herdr (borrowed, upstream ogulcancelik/herdr) — "the runtime your coding
# agents live on". bin/run.
#
# Primary operation: build the herdr runtime binary (`just build` → release
# binary) that supervises coding agents. This rig surfaces the build without a
# full compile on a bare checkout: it validates the Cargo workspace + just
# recipes and prints the build/run entry points.
#
# Usage:
#   bin/run            structural boot (fast)
#   bin/run build      just build (release binary — the primary op)
#   bin/run test       just test
set -euo pipefail
cd "$(dirname "$0")/.."

cmd="$(command -v cargo 2>/dev/null || true)"
CARGO=""
for c in /home/toxic/.cargo/bin/cargo "$cmd" /usr/local/bin/cargo /usr/bin/cargo; do
  [ -n "$c" ] && [ -x "$c" ] && { CARGO="$c"; break; }
done
[ -n "${CARGO:-}" ] || { echo "FAIL: cargo not found"; exit 1; }

case "${1:-boot}" in
  build) echo "== herdr run: build release =="; exec just build ;;
  test)  echo "== herdr run: test =="; exec just test ;;
  boot|*)
    echo "== herdr run: structural boot =="
    "$CARGO" metadata --no-deps --format-version 1 >/dev/null 2>&1 \
      || { echo "FAIL: cargo workspace does not parse"; exit 1; }
    [ -f justfile ] || { echo "FAIL: justfile missing"; exit 1; }
    echo "OK: cargo workspace parses; justfile present"
    echo "use: bin/run build -> just build (release runtime) | bin/run test -> just test"
    ;;
esac